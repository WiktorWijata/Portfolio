# Production build config.
#
# Deliberately empty VITE_API_URL: in production the frontend and API are
# served from the same origin, with the reverse proxy (Caddy, see the
# Infrastucture repo) routing /api* to the Portfolio.Api container. Axios
# then resolves the generated client's relative paths (e.g.
# /api/content-read/content) against the page's own origin, so no absolute
# URL needs to be baked into the build per environment.
#
# This file exists explicitly so production behavior never depends on
# whether a local .env happens to be present at build time (.env is
# gitignored and normally absent from CI, but a local `docker build`
# run outside CI would otherwise pick it up).
VITE_API_URL=https://localhost:7105
VITE_USE_MOCK=false
