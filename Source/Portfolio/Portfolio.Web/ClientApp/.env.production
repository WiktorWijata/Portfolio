# Production build config.
#
# VITE_API_URL is the relative base /api, not an absolute URL: in production
# the frontend and API are served from the same origin, with the reverse proxy
# (Caddy, see the Infrastucture repo) routing /api* to the Portfolio.Api
# container, which serves under that path base (UsePathBase("/api")). The
# generated client's paths are relative to the API root (/profile/...,
# /notification/..., /health), so axios needs the base to reach it; without
# it the requests hit the frontend container, which answers every unknown
# path with index.html. No absolute URL needs to be baked into the build
# per environment.
#
# This file exists explicitly so production behavior never depends on
# whether a local .env happens to be present at build time (.env is
# gitignored and normally absent from CI, but a local `docker build`
# run outside CI would otherwise pick it up).
VITE_API_URL=/api
VITE_USE_MOCK=false
