{
  "ConnectionStrings": {
    "Portfolio": "Server=${DB_HOST},${DB_PORT};Database=Portfolio;User Id=sa;Password=${DB_PASSWORD};TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Assistant": {
    "BaseUrl": "${INTEGRATORAI_BASE_URL}",
    "Contexts": {
      "PL": "${INTEGRATORAI_CONTEXT_PL}",
      "EN": "${INTEGRATORAI_CONTEXT_EN}"
    }
  },
  "Cors": {
    "AllowedOrigin": "${CORS_ALLOWED_ORIGIN}"
  }
}